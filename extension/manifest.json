{
  "manifest_version": 3,
  "name": "Claude Code Forwarder",
  "version": "1.4.0",
  "description": "Cmd+Shift+F to forward any page — Gmail, Slack, Plaud, Zendesk, Jira, or the web — to Claude Code",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "forward-to-claude": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Forward current page to Claude Code"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
